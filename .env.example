# Copia este archivo como .env y ajusta los valores de TU equipo.
# .env NUNCA se sube al repositorio (está en .gitignore).

APP_NAME="Torque · Gestión de Taller"
APP_TIMEZONE=America/Bogota
# true solo en desarrollo: muestra el detalle del error 500. En la sustentación: false
APP_DEBUG=false
# Minutos de inactividad antes de cerrar la sesión
SESSION_LIFETIME=20

# Liquidación simulada: IVA (fracción) y valor del diagnóstico cuando se rechaza la cotización
TALLER_IVA=0.19
TARIFA_DIAGNOSTICO=60000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=taller_automotriz
DB_USER=root
DB_PASS=
